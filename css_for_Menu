.clock-wipe {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 0%, 50% 0%);
    background-color: white;
    transform-origin: center;
    transform: rotate(0deg);
    z-index: 1000;
    opacity: 0;
    transition: transform 2s ease-in-out;
}

