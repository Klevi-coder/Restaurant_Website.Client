

body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg,rgb(125, 8, 8),rgb(161, 7, 7));
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: #333;
            position: relative;
        }

        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('img/backgr13.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            filter: blur(3px);
            z-index: -1;
        }

        .navbar {
            position: fixed; /* Fixes the navbar at the top */
            top: 0; /* Aligns it to the top of the page */
            width: 100%; /* Ensures it spans the full width */
            background-color: #fff3d3; /* Set a background color to avoid transparency */
            z-index: 1000; /* Ensures it stays above other content */
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* Adds a shadow for better visibility */
            display: flex; /* Aligns items in a row */
            justify-content: space-around; /* Distributes space evenly */
            padding: 15px 0; /* Adds padding for better spacing */
            margin: 0; /* Removes any default margin */
                }
                
                .navbar a {
                    font-size: 1.3rem;
                    text-decoration: none; /* Removes underline from links */
                    color: #333; /* Sets link color */
                    font-weight: bold; /* Makes links bold */
                    transition: color 0.3s; /* Smooth transition for hover effect */
                }
                
                .navbar a:hover {
                    color: #d32020; /* Changes color on hover */
                }
                
                body {
                    margin: 0; /* Removes default body margin */
                    padding-top: 60px; /* Adjust this value based on the height of your navbar */
                }
        
                .login_container {
                    background: rgba(255, 240, 240, 0.3);
                    padding: 20px;
                    border-radius: 10px;
                    width: 300px;
                    text-align: center;
                    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
                }









        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(5);
            }
        }

        input {
            width: 90%;
            padding: 8px;
            margin: 10px 0;
            display: block;
        }

        button {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            background-color: #790c0c;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background-color: rgb(211, 26, 26);
        }

        .password-container {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 18px;
        }

        .error-message {
            color: red;
            font-size: 14px;
            display: none; /* Fsheh mesazhin fillimisht */
            text-align: center;
        }

        h2 {
            text-align: center;
        }

        p {
            text-align: center;
        }