


        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg,rgb(169, 8, 8),rgb(123, 3, 3));
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: #70161e;
            position: relative;
        }

 /* Pseudo-element for the blurred background */
        body::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('img/backgr13.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh; /* Ensures the background covers the full viewport height */
            filter: blur(3px); /* Adjust the blur intensity */
            z-index: -1; /* Places the background behind the content */
        }




        .navbar {
          position: fixed; /* Fixes the navbar at the top */
          top: 0; /* Aligns it to the top of the page */
          width: 100%; /* Ensures it spans the full width */
          background-color: #fff3d3; /* Set a background color to avoid transparency */
          z-index: 1000; /* Ensures it stays above other content */
          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* Adds a shadow for better visibility */
          display: flex; /* Aligns items in a row */
          justify-content: space-around; /* Distributes space evenly */
          padding: 5px 0; /* Adds padding for better spacing */
          margin: 0; /* Removes any default margin */
              }
              
              .navbar a {
                  color: #000000;
                  position: relative;                /* Pozitivi për të menaxhuar stilin */
                  font-size: 1.2rem;
                  font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
                  font-weight: 600;
                  padding: 6px 6px;               /* Padding për butonët */
                  text-decoration: none;             /* Hiq linjën e nënvizimit */
                  border-radius: 5rem;              /* Rrethimi i këndëve */
                  transition: background 0.5s, box-shadow 0.5s; /* Kalimi i ngjyrës së sfondit dhe hijes */
                  background-color: transparent;     /* Sfondi fillestar */
              }
              
              .navbar a:hover {
                  color: #ffffff;            /* Ngjyra e tekstit kur hover */
                  background-color: #5e1313;             /* Ngjyra e sfondit kur hover */
              }


              
