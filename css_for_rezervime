    /* Për rregullimin e etiketave */

label {
  line-height: 1;
  background: linear-gradient(135deg,rgba(255, 255, 255, 0),rgba(255, 255, 255, 0));
  display: block;
  font-weight: bold;
  margin-bottom: 5px; 
  font-size: 14px; 
}

/* Për të gjitha fushat e input-it, select dhe button */
input, select, button {
  width: 100%; 
  padding: 12px; 
  margin-bottom: 15px;
  border: 1px solid #70161e;
  border-radius: 4px; 
  box-sizing: border-box;
  font-size: 16px;
}

.zona {
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* Qendro etiketat dhe opsionet në të majtë */
  margin-bottom: 15px;
}

.zona label {
  margin: 5px 0;
}

/* Për butonin */
button {
  background: linear-gradient(135deg, #70161e,#ff0000dd);
  color: rgb(255, 255, 255);
  border: none;
  cursor: pointer;
  padding: 10px 15px; 
  font-size: 16px;
  border-radius: 5px;
  transition: background 0.3s ease, transform 0.3s ease;
}

button:hover {
            background: linear-gradient(135deg, #ff0000db, #70161e);
            transform: translateY(-2px);
        }

        button:active {
            transform: translateY(0);
        }

/* Për mesazhet */
#mesazhi {
  margin-top: 20px;
  font-weight: bold;
  color: #ff0000bb;
  text-align: center; /* Qendro mesazhet në qendër */
}

/* Për të rregulluar hapësirat e përgjithshme të formularit */
form {
  width: 300px; /* Gjerësia maksimale e formularit */
  margin: 0 auto; /* Qendroje në faqe */
  padding: 20px; /* Hapësirë brenda */
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Hijë për një dizajn më të këndshëm */
  border-radius: 20px; /* Këndet e rrumbullakosura të kutisë */
  background-color: #ffffff67; /* Sfond i bardhë */
}

